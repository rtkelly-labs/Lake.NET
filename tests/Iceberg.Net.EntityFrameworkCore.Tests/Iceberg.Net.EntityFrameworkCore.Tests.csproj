<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The CI job that runs this project (tools/test-projects.sh; registry: Iceberg.Net.slnx) -->
    <CiSuite>unit</CiSuite>
    <RootNamespace>Iceberg.Net.EntityFrameworkCore.Tests</RootNamespace>
    <NoWarn>$(NoWarn);EF1001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Iceberg.Net.EntityFrameworkCore/Iceberg.Net.EntityFrameworkCore.csproj" />
    <!-- So that the suite can run on Parquet.Net too (ICEBERG_PARQUET_BACKEND=parquet-net). -->
    <ProjectReference Include="../../src/Iceberg.Net.Data.ParquetNet/Iceberg.Net.Data.ParquetNet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
