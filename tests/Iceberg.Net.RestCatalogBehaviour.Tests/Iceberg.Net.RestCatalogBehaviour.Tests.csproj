<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The CI job that runs this project (tools/test-projects.sh; registry: Iceberg.Net.slnx) -->
    <CiSuite>unit</CiSuite>
    <RootNamespace>Iceberg.Net.RestCatalogBehaviour.Tests</RootNamespace>
    <Description>Executable specifications (Gherkin, Reqnroll) for the REST catalog: the server in-process, driven by RestCatalog and raw HTTP.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="Reqnroll.xUnit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Iceberg.Net.RestServer/Iceberg.Net.RestServer.csproj" />
    <!-- So that the suite can run on Parquet.Net too (ICEBERG_PARQUET_BACKEND=parquet-net). -->
    <ProjectReference Include="../../src/Iceberg.Net.Data.ParquetNet/Iceberg.Net.Data.ParquetNet.csproj" />
    <ProjectReference Include="../../src/Iceberg.Net.Data/Iceberg.Net.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The in-process server host (WebApplicationFactory, no sockets) is the only code shared with another test project. -->
    <Compile Include="../Iceberg.Net.RestServer.Tests/ServerHost.cs" Link="ServerHost.cs" />
  </ItemGroup>
</Project>
