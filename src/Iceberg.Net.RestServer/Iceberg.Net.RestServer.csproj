<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Iceberg.Net.RestServer</RootNamespace>
    <Description>An Iceberg REST catalog server (ASP.NET Core) over a SQL (JDBC-layout) or in-memory pointer store.</Description>
    <!-- A server, not a library package: run it (dotnet run / publish) or reference the project. See docs/rest-server.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Iceberg.Net.Data/Iceberg.Net.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Iceberg.Net.RestServer.Tests" />
    <InternalsVisibleTo Include="Iceberg.Net.Fuzz" />
  </ItemGroup>
</Project>
