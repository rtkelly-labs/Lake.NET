<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- NuGet packaging for the libraries (tests, tools and projects not yet released are IsPackable=false). Releases: .github/workflows/release.yml. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <!-- A release passes -p:Version from CHANGELOG.md (scripts/ParseChangelog.cs); local packs get this. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">preview.1</VersionSuffix>
    <Authors>Ryan Kelly</Authors>
    <Copyright>Copyright (c) 2026 rtkelly-labs</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rtkelly-labs/Iceberg.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rtkelly-labs/Iceberg.NET.git</RepositoryUrl>
    <PackageTags>iceberg;apache-iceberg;lakehouse;parquet;glue;s3</PackageTags>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <!-- SourceLink (in the .NET SDK): sources and the commit are recorded in the symbols; CI builds are deterministic. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- XML docs ship with the packages; not every public member has a comment yet. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!--
      API compatibility (docs/lake/goal.md G14): every pack compares the public surface with the last published release
      and fails on a breaking change that isn't recorded in the project's CompatibilitySuppressions.xml. Accept a
      deliberate break by regenerating that file: dotnet pack <project> -p:GenerateCompatibilitySuppressionFile=true.
      Projects that have never been published (IsPackable=false today) skip it.
    -->
    <EnablePackageValidation Condition="'$(IsPackable)' == 'true'">true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.0.1-alpha.1</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../PACKAGE_README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
