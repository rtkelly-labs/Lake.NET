<Project>
  <ItemGroup>
    <!-- Iceberg physical formats -->
    <!-- Avro is a small in-house codec (Apache.Avro cannot parse logical types on fixed; see docs/libraries.md) -->
    <!-- ParquetSharp (Arrow C++ wrapper) over Parquet.Net: field IDs on group nodes are required for nested Iceberg columns -->
    <PackageVersion Include="ParquetSharp" Version="25.0.1.1" />
    <!-- Puffin blob codec (zstd); lz4 is not implemented -->
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.6" />
    <!-- Interop target: rtkelly-labs/Parquet.SourceGenerator (Roslyn generator over Parquet.Net), used only by tests -->
    <PackageVersion Include="Parquet.SourceGenerator" Version="0.0.3" />
    <PackageVersion Include="Parquet.Net" Version="6.1.0" />
    <!-- netstandard2.0 build of Core/Avro: language-feature polyfills and the BCL pieces netstandard2.0 lacks -->
    <PackageVersion Include="PolySharp" Version="1.15.0" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Text.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <!-- ActivitySource/Meter (IcebergTelemetry) for netstandard2.0; in-box on .NET 10 -->
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.13" />
    <!-- AWS -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.6" />
    <PackageVersion Include="AWSSDK.Glue" Version="4.0.116" />
    <PackageVersion Include="AWSSDK.Athena" Version="4.0.100.21" />
    <!-- EF Core provider (src/Iceberg.Net.EntityFrameworkCore): the major matches the net10.0 target -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <!-- Only for EF Core's ExecuteUpdate/ExecuteDelete operators and SetPropertyCalls (they live in the relational package); no relational services are used -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <!-- REST catalog server (src/Iceberg.Net.RestServer): bearer/JWT auth; tests host it with WebApplicationFactory -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <!-- The REST server's own OpenAPI document (/openapi/v1.json), diffed against the reference spec in tests -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Iceberg.Net.Spark: running generated Iceberg procedure scripts on EMR Serverless -->
    <PackageVersion Include="AWSSDK.EMRServerless" Version="4.0.101.4" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Apache.Arrow" Version="23.0.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
    <!-- Property-based / model-based testing (same major as Parquet.SourceGenerator's suite) -->
    <PackageVersion Include="FsCheck" Version="3.4.0" />
    <!-- Coverage-guided fuzzing harness (tests/Iceberg.Net.Fuzz, tools/fuzz.sh) -->
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
    <!-- BDD: Gherkin features executed by xUnit (Reqnroll is the maintained successor of SpecFlow) -->
    <PackageVersion Include="Reqnroll.xUnit" Version="3.3.4" />
  </ItemGroup>
</Project>
