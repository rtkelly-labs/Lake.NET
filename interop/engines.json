{
  "$comment": "Every reference engine and emulator version the suites run against, in one place (docs/lake/goal.md W5; gap review P1-8). Each pin lists the files that must carry this version; EngineVersionManifestTests fails when a file disagrees or names the image with another tag, so a bump is one edit here plus the files the test points at. The upkeep workflow runs the emulators at :latest to flag drift.",
  "engines": [
    {
      "name": "moto",
      "version": "5.2.4",
      "role": "S3, Glue, STS, Athena emulator",
      "pins": [
        {
          "file": "emulation/docker-compose.yml",
          "text": "motoserver/moto:${MOTO_TAG:-{version}}"
        },
        {
          "file": "interop/pyproject.toml",
          "text": "\"moto[server]=={version}\""
        },
        {
          "file": "tests/Iceberg.Net.RestServer.Tests/AuthenticatingMoto.cs",
          "text": "\"motoserver/moto:{version}\""
        }
      ]
    },
    {
      "name": "iceberg-rest-fixture",
      "version": "1.10.0",
      "role": "Iceberg Java REST catalog fixture",
      "pins": [
        {
          "file": "emulation/docker-compose.yml",
          "text": "apache/iceberg-rest-fixture:${REST_FIXTURE_TAG:-{version}}"
        }
      ]
    },
    {
      "name": "trino",
      "version": "478",
      "role": "Trino oracle",
      "pins": [
        {
          "file": "emulation/docker-compose.yml",
