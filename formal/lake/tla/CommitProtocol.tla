VARIABLE state

Cfg == [Ops |-> ([tag |-> "W1"] :> [tag |-> "Append", Item |-> [tag |-> "P"]] @@ [tag |-> "W2"] :> [tag |-> "Append", Item |-> [tag |-> "Q"]] @@ [tag |-> "W3"] :> [tag |-> "Overwrite", Item |-> [tag |-> "P"]]), MaxAttempts |-> 2, Faults |-> 1, Bugs |-> {}]

Actions == {
    [tag |-> "Begin", writer |-> [tag |-> "W1"]],
    [tag |-> "Begin", writer |-> [tag |-> "W2"]],
    [tag |-> "Begin", writer |-> [tag |-> "W3"]],
    [tag |-> "Apply", writer |-> [tag |-> "W1"], attempt |-> 1],
    [tag |-> "Apply", writer |-> [tag |-> "W1"], attempt |-> 2],
    [tag |-> "Apply", writer |-> [tag |-> "W2"], attempt |-> 1],
    [tag |-> "Apply", writer |-> [tag |-> "W2"], attempt |-> 2],
    [tag |-> "Apply", writer |-> [tag |-> "W3"], attempt |-> 1],
    [tag |-> "Apply", writer |-> [tag |-> "W3"], attempt |-> 2],
    [tag |-> "Ack", writer |-> [tag |-> "W1"], attempt |-> 1],
    [tag |-> "Ack", writer |-> [tag |-> "W1"], attempt |-> 2],
    [tag |-> "Ack", writer |-> [tag |-> "W2"], attempt |-> 1],
    [tag |-> "Ack", writer |-> [tag |-> "W2"], attempt |-> 2],
    [tag |-> "Ack", writer |-> [tag |-> "W3"], attempt |-> 1],
    [tag |-> "Ack", writer |-> [tag |-> "W3"], attempt |-> 2],
    [tag |-> "Reject", writer |-> [tag |-> "W1"], attempt |-> 1],
    [tag |-> "Reject", writer |-> [tag |-> "W1"], attempt |-> 2],
    [tag |-> "Reject", writer |-> [tag |-> "W2"], attempt |-> 1],
    [tag |-> "Reject", writer |-> [tag |-> "W2"], attempt |-> 2],
    [tag |-> "Reject", writer |-> [tag |-> "W3"], attempt |-> 1],
    [tag |-> "Reject", writer |-> [tag |-> "W3"], attempt |-> 2],
    [tag |-> "ServerError", writer |-> [tag |-> "W1"], attempt |-> 1],
    [tag |-> "ServerError", writer |-> [tag |-> "W1"], attempt |-> 2],
    [tag |-> "ServerError", writer |-> [tag |-> "W2"], attempt |-> 1],
    [tag |-> "ServerError", writer |-> [tag |-> "W2"], attempt |-> 2],
    [tag |-> "ServerError", writer |-> [tag |-> "W3"], attempt |-> 1],
    [tag |-> "ServerError", writer |-> [tag |-> "W3"], attempt |-> 2],
    [tag |-> "Timeout", writer |-> [tag |-> "W1"], attempt |-> 1],
    [tag |-> "Timeout", writer |-> [tag |-> "W1"], attempt |-> 2],
    [tag |-> "Timeout", writer |-> [tag |-> "W2"], attempt |-> 1],
    [tag |-> "Timeout", writer |-> [tag |-> "W2"], attempt |-> 2],
    [tag |-> "Timeout", writer |-> [tag |-> "W3"], attempt |-> 1],
    [tag |-> "Timeout", writer |-> [tag |-> "W3"], attempt |-> 2]
}

Has(bug, cfg) ==
    (bug \in cfg.Bugs)

Awaiting(w, k, s) ==
    (LET matchValue == s.Writers[w]
     IN  ((matchValue.tag = "Waiting") /\ (matchValue.attempt = k)))

Apply(cfg, w, k, s) ==
    (LET meta == [tag |-> "Meta", writer |-> w, attempt |-> k]
     IN  (IF (~(meta \in (DOMAIN s.InFlight)))
           THEN [tag |-> "None"]
           ELSE (LET won == (Has([tag |-> "BlindSwap"], cfg) \/ (s.Pointer = s.InFlight[meta]))
                 IN  [tag |-> "Some", Value |-> (LET v_Pointer == (IF won
                                         THEN meta
                                         ELSE s.Pointer)
                          v_InFlight == [key \in ((DOMAIN s.InFlight) \ {meta}) |-> s.InFlight[key]]
                          v_Replies == (IF Awaiting(w, k, s)
                                         THEN ((meta :> won) @@ s.Replies)
                                         ELSE s.Replies)
                      IN  [s EXCEPT !.Pointer = v_Pointer, !.InFlight = v_InFlight, !.Replies = v_Replies])])))

AttemptOf(w, k, h) ==
    {x \in h : ((x.Writer = [tag |-> "Some", Value |-> w]) /\ (x.Attempt = k))}

Ack(w, k, s) ==
    (LET meta == [tag |-> "Meta", writer |-> w, attempt |-> k]
     IN  (IF ((Awaiting(w, k, s) /\ (meta \in (DOMAIN s.Replies))) /\ s.Replies[meta])
           THEN [tag |-> "Some", Value |-> (LET v_Replies == [key \in ((DOMAIN s.Replies) \ {meta}) |-> s.Replies[key]]
                     v_Writers == ((w :> [tag |-> "Succeeded"]) @@ s.Writers)
                     v_Published == (s.Published \cup AttemptOf(w, k, s.Metadata[meta]))
                 IN  [s EXCEPT !.Replies = v_Replies, !.Writers = v_Writers, !.Published = v_Published])]
           ELSE [tag |-> "None"]))

PartOf(op) ==
    (IF (op.tag = "Overwrite")
      THEN op.Item
      ELSE op.Item)

PartitionOf(cfg, f) ==
    (IF (f.tag = "Data")
      THEN PartOf(cfg.Ops[f.writer])
      ELSE [tag |-> "P"])

AddsTo(cfg, p, x) ==
    (\E f \in x.Adds : (PartitionOf(cfg, f) = p))

History(s) ==
    s.Metadata[s.Pointer]

Valid(cfg, w, start, s) ==
    (LET matchValue == cfg.Ops[w]
     IN  (IF (matchValue.tag = "Overwrite")
           THEN (Has([tag |-> "SnapshotIsolation"], cfg) \/ (~(\E x \in History(s) : ((x.SeqNo > start) /\ AddsTo(cfg, matchValue.Item, x)))))
           ELSE TRUE))

Propose(w, k, start, removes, s) ==
    (LET h == History(s)
         snapshot == [SeqNo |-> (Cardinality(h) + 1), Writer |-> [tag |-> "Some", Value |-> w], Attempt |-> k, Adds |-> {[tag |-> "Data", writer |-> w]}, Removes |-> removes, Start |-> start]
         meta == [tag |-> "Meta", writer |-> w, attempt |-> k]
         v_Metadata == ((meta :> (h \cup {snapshot})) @@ s.Metadata)
         v_Store == (s.Store \cup {meta})
         v_InFlight == ((meta :> s.Pointer) @@ s.InFlight)
         v_Writers == ((w :> [tag |-> "Waiting", attempt |-> k, start |-> start, removes |-> removes]) @@ s.Writers)
     IN  [s EXCEPT !.Metadata = v_Metadata, !.Store = v_Store, !.InFlight = v_InFlight, !.Writers = v_Writers])

Retry(cfg, w, k, s) ==
    (LET matchValue == s.Writers[w]
     IN  (IF (matchValue.tag = "Waiting")
           THEN (IF ((k < cfg.MaxAttempts) /\ Valid(cfg, w, matchValue.start, s))
                  THEN [tag |-> "Some", Value |-> Propose(w, (k + 1), matchValue.start, matchValue.removes, s)]
                  ELSE [tag |-> "Some", Value |-> (LET v_Writers == ((w :> [tag |-> "Failed"]) @@ s.Writers)
                        IN  [s EXCEPT !.Writers = v_Writers])])
           ELSE [tag |-> "None"]))

Reject(cfg, w, k, s) ==
    (LET meta == [tag |-> "Meta", writer |-> w, attempt |-> k]
     IN  (IF ((Awaiting(w, k, s) /\ (meta \in (DOMAIN s.Replies))) /\ (~s.Replies[meta]))
           THEN Retry(cfg, w, k, (LET v_Replies == [key \in ((DOMAIN s.Replies) \ {meta}) |-> s.Replies[key]]
                     v_Store == (s.Store \ {meta})
                 IN  [s EXCEPT !.Store = v_Store, !.Replies = v_Replies]))
           ELSE [tag |-> "None"]))

UnknownOutcome(cfg, w, k, s) ==
    (LET meta == [tag |-> "Meta", writer |-> w, attempt |-> k]
     IN  (((s.Faults > 0) /\ Awaiting(w, k, s)) /\ ((meta \in (DOMAIN s.InFlight)) \/ (meta \in (DOMAIN s.Replies)))))

AfterUnknown(cfg, w, k, s) ==
    (LET meta == [tag |-> "Meta", writer |-> w, attempt |-> k]
         v_Faults == (s.Faults - 1)
         v_Replies == [key \in ((DOMAIN s.Replies) \ {meta}) |-> s.Replies[key]]
         v_Store == (IF Has([tag |-> "DeleteOnUnknown"], cfg)
                      THEN (s.Store \ {meta})
                      ELSE s.Store)
     IN  [s EXCEPT !.Store = v_Store, !.Replies = v_Replies, !.Faults = v_Faults])

ServerError(cfg, w, k, s) ==
    (IF (~UnknownOutcome(cfg, w, k, s))
      THEN [tag |-> "None"]
      ELSE (LET s1 == (LET bind_ == AfterUnknown(cfg, w, k, s)
                           v_InFlight == [key \in ((DOMAIN s.InFlight) \ {[tag |-> "Meta", writer |-> w, attempt |-> k]}) |-> s.InFlight[key]]
                       IN  [bind_ EXCEPT !.InFlight = v_InFlight])
                mine == AttemptOf(w, k, History(s1))
            IN  (IF Has([tag |-> "RetryUnknownBlindly"], cfg)
                  THEN Retry(cfg, w, k, s1)
                  ELSE (IF (~(mine = {}))
                         THEN [tag |-> "Some", Value |-> (LET v_Writers == ((w :> [tag |-> "Succeeded"]) @@ s1.Writers)
                                   v_Published == (s1.Published \cup mine)
                               IN  [s1 EXCEPT !.Writers = v_Writers, !.Published = v_Published])]
                         ELSE Retry(cfg, w, k, s1)))))

Timeout(cfg, w, k, s) ==
    (IF (~UnknownOutcome(cfg, w, k, s))
      THEN [tag |-> "None"]
      ELSE (LET s1 == AfterUnknown(cfg, w, k, s)
            IN  (IF Has([tag |-> "RetryUnknownBlindly"], cfg)
                  THEN Retry(cfg, w, k, s1)
                  ELSE [tag |-> "Some", Value |-> (LET v_Writers == ((w :> [tag |-> "Unknown"]) @@ s1.Writers)
                        IN  [s1 EXCEPT !.Writers = v_Writers])])))

LiveFiles(h) ==
    ((UNION {x.Adds : x \in h}) \ (UNION {x_2.Removes : x_2 \in h}))

BeginCommit(cfg, w, s) ==
    (IF (s.Writers[w] # [tag |-> "Idle"])
      THEN [tag |-> "None"]
      ELSE (LET h == History(s)
                removes == (LET matchValue == cfg.Ops[w]
                            IN  (IF (matchValue.tag = "Overwrite")
                                  THEN {f \in LiveFiles(h) : (PartitionOf(cfg, f) = matchValue.Item)}
                                  ELSE {}))
            IN  [tag |-> "Some", Value |-> Propose(w, 1, Cardinality(h), removes, (LET v_Store == (s.Store \cup {[tag |-> "Data", writer |-> w]})
                 IN  [s EXCEPT !.Store = v_Store]))]))

Step(cfg, action, s) ==
    (IF (action.tag = "Apply")
      THEN Apply(cfg, action.writer, action.attempt, s)
      ELSE (IF (action.tag = "Ack")
             THEN Ack(action.writer, action.attempt, s)
             ELSE (IF (action.tag = "Reject")
                    THEN Reject(cfg, action.writer, action.attempt, s)
                    ELSE (IF (action.tag = "ServerError")
                           THEN ServerError(cfg, action.writer, action.attempt, s)
                           ELSE (IF (action.tag = "Timeout")
                                  THEN Timeout(cfg, action.writer, action.attempt, s)
                                  ELSE BeginCommit(cfg, action.writer, s))))))

ByWriter(w, h) ==
    {x \in h : (x.Writer = [tag |-> "Some", Value |-> w])}

AtMostOnce(cfg, s) ==
    (\A w \in (DOMAIN cfg.Ops) : (Cardinality(ByWriter(w, History(s))) <= 1))

NoLostCommit(cfg, s) ==
    (s.Published \subseteq History(s))

IsMetaOf(w, f) ==
    ((f.tag = "Meta") /\ (f.writer = w))

FailedNeverApplies(cfg, s) ==
    (\A w \in (DOMAIN s.Writers) : ((s.Writers[w] # [tag |-> "Failed"]) \/ ((ByWriter(w, History(s)) = {}) /\ (~(\E m \in (DOMAIN s.InFlight) : IsMetaOf(w, m))))))

ReachableFilesExist(cfg, s) ==
    ((s.Pointer \in s.Store) /\ (LiveFiles(History(s)) \subseteq s.Store))

ConflictFree(cfg, h, o) ==
    ((o.Writer.tag = "None") \/ (LET matchValue == cfg.Ops[o.Writer.Value]
     IN  ((matchValue.tag = "Append") \/ (~(\E x \in h : (((x.SeqNo > o.Start) /\ (x.SeqNo < o.SeqNo)) /\ AddsTo(cfg, matchValue.Item, x)))))))

SerializableOverwrite(cfg, s) ==
    (LET h == History(s)
     IN  (\A o \in h : ConflictFree(cfg, h, o)))

Init == state = [Pointer |-> [tag |-> "Meta0"], Metadata |-> ([tag |-> "Meta0"] :> {[SeqNo |-> 1, Writer |-> [tag |-> "None"], Attempt |-> 0, Adds |-> {[tag |-> "Seed"]}, Removes |-> {}, Start |-> 0]}), Store |-> {[tag |-> "Seed"], [tag |-> "Meta0"]}, InFlight |-> <<>>, Replies |-> <<>>, Writers |-> ([tag |-> "W1"] :> [tag |-> "Idle"] @@ [tag |-> "W2"] :> [tag |-> "Idle"] @@ [tag |-> "W3"] :> [tag |-> "Idle"]), Faults |-> 1, Published |-> {}]

Next == \E a \in Actions : LET r == Step(Cfg, a, state) IN (r.tag = "Some") /\ (state' = r.Value)

Spec == Init /\ [][Next]_state

Inv_AtMostOnce == AtMostOnce(Cfg, state)

Inv_NoLostCommit == NoLostCommit(Cfg, state)

Inv_FailedNeverApplies == FailedNeverApplies(Cfg, state)

Inv_ReachableFilesExist == ReachableFilesExist(Cfg, state)

Inv_SerializableOverwrite == SerializableOverwrite(Cfg, state)

