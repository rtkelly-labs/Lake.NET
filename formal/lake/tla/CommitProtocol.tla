    [tag |-> "Resend", writer |-> [tag |-> "W2"], attempt |-> 1],
    [tag |-> "Resend", writer |-> [tag |-> "W2"], attempt |-> 2],
    [tag |-> "Resend", writer |-> [tag |-> "W3"], attempt |-> 1],
    [tag |-> "Resend", writer |-> [tag |-> "W3"], attempt |-> 2]
}

Has(bug, cfg) ==
    (bug \in cfg.Bugs)

Wins(cfg, expected, s) ==
    (Has([tag |-> "BlindSwap"], cfg) \/ (s.Pointer = expected))

Awaiting(w, k, s) ==
    (LET matchValue == s.Writers[w]
     IN  ((matchValue.tag = "Waiting") /\ (matchValue.attempt = k)))

Apply(cfg, w, k, s) ==
    (LET meta == [tag |-> "Meta", writer |-> w, attempt |-> k]
     IN  (IF (~(meta \in (DOMAIN s.InFlight)))
           THEN [tag |-> "None"]
           ELSE (LET won == Wins(cfg, s.InFlight[meta], s)
                 IN  [tag |-> "Some", Value |-> (LET v_Pointer == (IF won
                                         THEN meta
                                         ELSE s.Pointer)
                          v_InFlight == [key \in ((DOMAIN s.InFlight) \ {meta}) |-> s.InFlight[key]]
                          v_Replies == (IF Awaiting(w, k, s)
                                         THEN ((meta :> won) @@ s.Replies)
                                         ELSE s.Replies)
                      IN  [s EXCEPT !.Pointer = v_Pointer, !.InFlight = v_InFlight, !.Replies = v_Replies])])))

AttemptOf(w, k, h) ==
    {x \in h : ((x.Writer = [tag |-> "Some", Value |-> w]) /\ (x.Attempt = k))}

Ack(w, k, s) ==
    (LET meta == [tag |-> "Meta", writer |-> w, attempt |-> k]
     IN  (IF ((Awaiting(w, k, s) /\ (meta \in (DOMAIN s.Replies))) /\ s.Replies[meta])
           THEN [tag |-> "Some", Value |-> (LET v_Replies == [key \in ((DOMAIN s.Replies) \ {meta}) |-> s.Replies[key]]
                     v_Writers == ((w :> [tag |-> "Succeeded"]) @@ s.Writers)
                     v_Published == (s.Published \cup AttemptOf(w, k, s.Metadata[meta]))
                 IN  [s EXCEPT !.Replies = v_Replies, !.Writers = v_Writers, !.Published = v_Published])]
           ELSE [tag |-> "None"]))

History(s) ==
    s.Metadata[s.Pointer]

RemovesFiles(op) ==
    ((op.tag = "Overwrite") \/ ((op.tag = "Delete") /\ TRUE))

PartOf(op) ==
    (IF (op.tag = "Overwrite")
      THEN op.Item
      ELSE (IF (op.tag = "Delete")
             THEN op.Item
             ELSE op.Item))

PartitionOf(cfg, f) ==
    (IF (f.tag = "Data")
      THEN PartOf(cfg.Ops[f.writer])
      ELSE [tag |-> "P"])

AddsTo(cfg, p, x) ==
    (\E f \in x.Adds : (PartitionOf(cfg, f) = p))

LiveFiles(h) ==
    ((UNION {x.Adds : x \in h}) \ (UNION {x_2.Removes : x_2 \in h}))

Valid(cfg, w, start, removedAtStart, s) ==
    (LET h == History(s)
     IN  (((~RemovesFiles(cfg.Ops[w])) \/ Has([tag |-> "SnapshotIsolation"], cfg)) \/ ((~(\E x \in h : ((x.SeqNo > start) /\ AddsTo(cfg, PartOf(cfg.Ops[w]), x)))) /\ (Has([tag |-> "NoMissingDeleteCheck"], cfg) \/ (removedAtStart \subseteq LiveFiles(h))))))

AddsOf(cfg, w) ==
    (LET matchValue == cfg.Ops[w]
     IN  (IF (matchValue.tag = "Append")
           THEN {[tag |-> "Data", writer |-> w]}
           ELSE (IF (matchValue.tag = "Overwrite")
                  THEN {[tag |-> "Data", writer |-> w]}
                  ELSE {})))

PlanRemoves(cfg, w, h) ==
    (IF RemovesFiles(cfg.Ops[w])
      THEN {f \in LiveFiles(h) : (PartitionOf(cfg, f) = PartOf(cfg.Ops[w]))}
      ELSE {})

Propose(cfg, w, k, start, removedAtStart, s) ==
    (LET h == History(s)
         snapshot == [SeqNo |-> (Cardinality(h) + 1), Writer |-> [tag |-> "Some", Value |-> w], Attempt |-> k, Adds |-> AddsOf(cfg, w), Removes |-> PlanRemoves(cfg, w, h), Start |-> start]
         meta == [tag |-> "Meta", writer |-> w, attempt |-> k]
         v_Metadata == ((meta :> (h \cup {snapshot})) @@ s.Metadata)
         v_Store == (s.Store \cup {meta})
         v_InFlight == ((meta :> s.Pointer) @@ s.InFlight)
         v_Sent == ((meta :> s.Pointer) @@ s.Sent)
         v_Writers == ((w :> [tag |-> "Waiting", attempt |-> k, start |-> start, removedAtStart |-> removedAtStart]) @@ s.Writers)
     IN  [s EXCEPT !.Metadata = v_Metadata, !.Store = v_Store, !.InFlight = v_InFlight, !.Writers = v_Writers, !.Sent = v_Sent])

Retry(cfg, w, k, s) ==
    (LET matchValue == s.Writers[w]
     IN  (IF (matchValue.tag = "Waiting")
           THEN (IF ((k < cfg.MaxAttempts) /\ Valid(cfg, w, matchValue.start, matchValue.removedAtStart, s))
                  THEN [tag |-> "Some", Value |-> Propose(cfg, w, (k + 1), matchValue.start, matchValue.removedAtStart, s)]
                  ELSE [tag |-> "Some", Value |-> (LET v_Writers == ((w :> [tag |-> "Failed"]) @@ s.Writers)
                        IN  [s EXCEPT !.Writers = v_Writers])])
           ELSE [tag |-> "None"]))

Reject(cfg, w, k, s) ==
    (LET meta == [tag |-> "Meta", writer |-> w, attempt |-> k]
     IN  (IF ((Awaiting(w, k, s) /\ (meta \in (DOMAIN s.Replies))) /\ (~s.Replies[meta]))
           THEN Retry(cfg, w, k, (LET v_Replies == [key \in ((DOMAIN s.Replies) \ {meta}) |-> s.Replies[key]]
                     v_Store == (s.Store \ {meta})
                 IN  [s EXCEPT !.Store = v_Store, !.Replies = v_Replies]))
           ELSE [tag |-> "None"]))

UnknownOutcome(cfg, w, k, s) ==
    (LET meta == [tag |-> "Meta", writer |-> w, attempt |-> k]
     IN  (((s.Faults > 0) /\ Awaiting(w, k, s)) /\ ((meta \in (DOMAIN s.InFlight)) \/ (meta \in (DOMAIN s.Replies)))))

AfterUnknown(cfg, w, k, s) ==
    (LET meta == [tag |-> "Meta", writer |-> w, attempt |-> k]
         v_Faults == (s.Faults - 1)
         v_Replies == [key \in ((DOMAIN s.Replies) \ {meta}) |-> s.Replies[key]]
         v_Store == (IF Has([tag |-> "DeleteOnUnknown"], cfg)
                      THEN (s.Store \ {meta})
                      ELSE s.Store)
     IN  [s EXCEPT !.Store = v_Store, !.Replies = v_Replies, !.Faults = v_Faults])

ServerError(cfg, w, k, s) ==
    (IF (~UnknownOutcome(cfg, w, k, s))
      THEN [tag |-> "None"]
      ELSE (LET s1 == (LET bind_ == AfterUnknown(cfg, w, k, s)
                           v_InFlight == [key \in ((DOMAIN s.InFlight) \ {[tag |-> "Meta", writer |-> w, attempt |-> k]}) |-> s.InFlight[key]]
                       IN  [bind_ EXCEPT !.InFlight = v_InFlight])
                mine == AttemptOf(w, k, History(s1))
            IN  (IF Has([tag |-> "RetryUnknownBlindly"], cfg)
                  THEN Retry(cfg, w, k, s1)
                  ELSE (IF (~(mine = {}))
                         THEN [tag |-> "Some", Value |-> (LET v_Writers == ((w :> [tag |-> "Succeeded"]) @@ s1.Writers)
                                   v_Published == (s1.Published \cup mine)
                               IN  [s1 EXCEPT !.Writers = v_Writers, !.Published = v_Published])]
                         ELSE Retry(cfg, w, k, s1)))))

Timeout(cfg, w, k, s) ==
    (IF (~UnknownOutcome(cfg, w, k, s))
      THEN [tag |-> "None"]
      ELSE (LET s1 == AfterUnknown(cfg, w, k, s)
            IN  (IF Has([tag |-> "RetryUnknownBlindly"], cfg)
                  THEN Retry(cfg, w, k, s1)
                  ELSE [tag |-> "Some", Value |-> (LET v_Writers == ((w :> [tag |-> "Unknown"]) @@ s1.Writers)
                        IN  [s1 EXCEPT !.Writers = v_Writers])])))

Resend(cfg, w, k, s) ==
    (IF (~UnknownOutcome(cfg, w, k, s))
      THEN [tag |-> "None"]
      ELSE (IF Has([tag |-> "NoIdempotencyKey"], cfg)
             THEN (LET meta == [tag |-> "Meta", writer |-> w, attempt |-> k]
                   IN  [tag |-> "Some", Value |-> (LET v_Faults == (s.Faults - 1)
                            v_InFlight == ((meta :> s.Sent[meta]) @@ s.InFlight)
                            v_Replies == [key \in ((DOMAIN s.Replies) \ {meta}) |-> s.Replies[key]]
                        IN  [s EXCEPT !.InFlight = v_InFlight, !.Replies = v_Replies, !.Faults = v_Faults])])
             ELSE [tag |-> "Some", Value |-> (LET v_Faults_2 == (s.Faults - 1)
                   IN  [s EXCEPT !.Faults = v_Faults_2])]))

MetadataOf(x) ==
    (IF (x.Writer.tag = "None")
      THEN [tag |-> "Meta0"]
      ELSE [tag |-> "Meta", writer |-> x.Writer.Value, attempt |-> x.Attempt])

Reachable(s, f) ==
    (LET h == History(s)
     IN  (((f = s.Pointer) \/ (f \in {MetadataOf(x) : x \in h})) \/ (\E x_2 \in h : (f \in x_2.Adds))))

IsWaiting(w, s) ==
    (LET matchValue == s.Writers[w]
     IN  ((matchValue.tag = "Waiting") /\ TRUE))

IsMetaOf(w, f) ==
    ((f.tag = "Meta") /\ (f.writer = w))

Young(s, f) ==
    (IF (f.tag = "Data")
      THEN (IsWaiting(f.writer, s) \/ (\E m \in (DOMAIN s.InFlight) : IsMetaOf(f.writer, m)))
      ELSE ((f.tag = "Meta") /\ ((f \in (DOMAIN s.InFlight)) \/ Awaiting(f.writer, f.attempt, s))))

CleanOrphans(cfg, s) ==
    (LET doomed == {f \in s.Store : ((~Reachable(s, f)) /\ (Has([tag |-> "OrphanCleanupNoAge"], cfg) \/ (~Young(s, f))))}
     IN  (IF ((~cfg.Cleaner) \/ (doomed = {}))
           THEN [tag |-> "None"]
           ELSE [tag |-> "Some", Value |-> (LET v_Store == (s.Store \ doomed)
                 IN  [s EXCEPT !.Store = v_Store])]))

BeginCommit(cfg, w, s) ==
    (IF (s.Writers[w] # [tag |-> "Idle"])
      THEN [tag |-> "None"]
      ELSE (LET h == History(s)
            IN  [tag |-> "Some", Value |-> Propose(cfg, w, 1, Cardinality(h), PlanRemoves(cfg, w, h), (LET v_Store == (AddsOf(cfg, w) \cup s.Store)
                 IN  [s EXCEPT !.Store = v_Store]))]))

Step(cfg, action, s) ==
    (IF (action.tag = "Apply")
      THEN Apply(cfg, action.writer, action.attempt, s)
      ELSE (IF (action.tag = "Ack")
             THEN Ack(action.writer, action.attempt, s)
             ELSE (IF (action.tag = "Reject")
                    THEN Reject(cfg, action.writer, action.attempt, s)
                    ELSE (IF (action.tag = "ServerError")
                           THEN ServerError(cfg, action.writer, action.attempt, s)
                           ELSE (IF (action.tag = "Timeout")
                                  THEN Timeout(cfg, action.writer, action.attempt, s)
                                  ELSE (IF (action.tag = "Resend")
                                         THEN Resend(cfg, action.writer, action.attempt, s)
                                         ELSE (IF (action.tag = "CleanOrphans")
                                                THEN CleanOrphans(cfg, s)
                                                ELSE BeginCommit(cfg, action.writer, s))))))))

ByWriter(w, h) ==
    {x \in h : (x.Writer = [tag |-> "Some", Value |-> w])}

AtMostOnce(cfg, s) ==
    (\A w \in (DOMAIN cfg.Ops) : (Cardinality(ByWriter(w, History(s))) <= 1))

NoLostCommit(cfg, s) ==
    (s.Published \subseteq History(s))

FailedNeverApplies(cfg, s) ==
    (\A w \in (DOMAIN s.Writers) : ((s.Writers[w] # [tag |-> "Failed"]) \/ ((ByWriter(w, History(s)) = {}) /\ (~(\E m \in (DOMAIN s.InFlight) : (IsMetaOf(w, m) /\ Wins(cfg, s.InFlight[m], s)))))))

ReachableFilesExist(cfg, s) ==
    (LET h == History(s)
     IN  (((s.Pointer \in s.Store) /\ ({MetadataOf(x) : x \in h} \subseteq s.Store)) /\ ((UNION {x_2.Adds : x_2 \in h}) \subseteq s.Store)))

Touches(cfg, p, x) ==
    (AddsTo(cfg, p, x) \/ (\E f \in x.Removes : (PartitionOf(cfg, f) = p)))

ConflictFree(cfg, h, o) ==
    ((o.Writer.tag = "None") \/ ((~RemovesFiles(cfg.Ops[o.Writer.Value])) \/ (~(\E x \in h : (((x.SeqNo > o.Start) /\ (x.SeqNo < o.SeqNo)) /\ Touches(cfg, PartOf(cfg.Ops[o.Writer.Value]), x))))))

SerializableRemoval(cfg, s) ==
    (LET h == History(s)
     IN  (\A o \in h : ConflictFree(cfg, h, o)))

Init == state = [Pointer |-> [tag |-> "Meta0"], Metadata |-> ([tag |-> "Meta0"] :> {[SeqNo |-> 1, Writer |-> [tag |-> "None"], Attempt |-> 0, Adds |-> {[tag |-> "Seed"]}, Removes |-> {}, Start |-> 0]}), Store |-> {[tag |-> "Seed"], [tag |-> "Meta0"]}, InFlight |-> <<>>, Replies |-> <<>>, Writers |-> ([tag |-> "W1"] :> [tag |-> "Idle"] @@ [tag |-> "W2"] :> [tag |-> "Idle"] @@ [tag |-> "W3"] :> [tag |-> "Idle"]), Faults |-> 1, Sent |-> <<>>, Published |-> {}]

Next == \E a \in Actions : LET r == Step(Cfg, a, state) IN (r.tag = "Some") /\ (state' = r.Value)

Spec == Init /\ [][Next]_state

Inv_AtMostOnce == AtMostOnce(Cfg, state)

Inv_NoLostCommit == NoLostCommit(Cfg, state)

Inv_FailedNeverApplies == FailedNeverApplies(Cfg, state)

Inv_ReachableFilesExist == ReachableFilesExist(Cfg, state)

Inv_SerializableRemoval == SerializableRemoval(Cfg, state)

