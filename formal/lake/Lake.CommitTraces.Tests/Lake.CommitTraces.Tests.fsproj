<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Harness.fs" />
    <Compile Include="CommitGrammarTests.fs" />
    <Compile Include="ProjectionTests.fs" />
    <Compile Include="BrokenWriterTests.fs" />
    <Compile Include="SoakTraceTests.fs" />
    <Compile Include="ConformanceTraceTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Lake.CommitTraces/Lake.CommitTraces.fsproj" />
    <!-- The model's conformance driver, so model runs on the real commit path can be traced. -->
    <ProjectReference Include="../Lake.CommitProtocol.Tests/Lake.CommitProtocol.Tests.fsproj" />
    <!-- The real catalog and commit path, by relative path (formal/ is not in Iceberg.Net.slnx). -->
    <ProjectReference Include="../../../src/Iceberg.Net.Catalog/Iceberg.Net.Catalog.csproj" />
    <ProjectReference Include="../../../src/Iceberg.Net.Data/Iceberg.Net.Data.csproj" />
  </ItemGroup>
</Project>
