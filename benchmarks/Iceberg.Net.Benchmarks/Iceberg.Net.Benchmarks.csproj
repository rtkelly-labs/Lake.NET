<Project Sdk="Microsoft.NET.Sdk">
  <!-- Macro benchmarks, run by .github/workflows/benchmarks.yml. Not in Iceberg.Net.slnx: CI builds and tests the
       solution, and these take minutes. How to run them: docs/regression-suite.md (Performance). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Iceberg.Net.Benchmarks</RootNamespace>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Iceberg.Net.Catalog/Iceberg.Net.Catalog.csproj" />
    <ProjectReference Include="../../src/Iceberg.Net.Data/Iceberg.Net.Data.csproj" />
  </ItemGroup>
</Project>
